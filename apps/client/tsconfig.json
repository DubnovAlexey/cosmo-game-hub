{
  "compilerOptions": {
    // [EN] Core JavaScript version target
    // [RU] Базовая целевая версия JavaScript
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    // [EN] React JSX transformation support
    // [RU] Поддержка трансформации React JSX
    "jsx": "react-jsx",

    // [EN] CRITICAL: Inject Vite environment and Node types in a single array
    // [RU] КРИТИЧНО: Внедряем типы окружения Vite и Node в единый массив
    "types": ["vite/client", "node"],

    // [EN] Bundler module resolution settings
    // [RU] Настройки разрешения модулей для сборщика
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    // [EN] Base directory for absolute imports
    // [RU] Базовая директория для абсолютных импортов
    "baseUrl": ".",

    // [EN] Three aliases = the three top-level parts of the app (see COSMO_GAME_HUB_BIBLE.md (English section) at the repo root, "Boundaries"):
    //      @shell — the site around the games, @shared — code used by two or more games, @games — the games.
    //      Inside one game folder imports stay relative, so a game folder can be read, moved and tested whole.
    // [RU] Три алиаса = три верхние части приложения (см. COSMO_GAME_HUB_BIBLE.md в корне репозитория, «Границы»):
    //      @shell — сайт вокруг игр, @shared — код для двух и более игр, @games — сами игры.
    //      Внутри папки одной игры импорты относительные: папку игры можно читать, переносить и тестировать целиком.
    "paths": {
      "@shell/*": ["src/shell/*"],
      "@shared/*": ["src/shared/*"],
      "@games/*": ["src/games/*"]
    },

    // [EN] Strict type-checking rules
    // [RU] Строгие правила проверки типов
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },

  // [EN] Include source files and bundler config
  // [RU] Включаем файлы исходного кода и конфиг сборщика
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}