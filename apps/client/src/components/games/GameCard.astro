---
import { withBase } from '@utils/withBase';

// Define the shape of the component properties using TypeScript
interface Props {
    title: string;
    description: string;
    badge?: string;
    gameUrl: string;
    coverUrl?: string;
    status: 'playable' | 'soon';
    icon?: string;
}

// Destructure the properties from Astro.props
const { title, description, badge, gameUrl, coverUrl, status, icon } = Astro.props;

// [EN] A game without its own page gets a "Coming soon" card: no link, no misleading badge.
// [RU] Игра без своей страницы получает карточку «Скоро»: без ссылки и без вводящего в заблуждение значка.
const isPlayable = status === 'playable';
const shownBadge = isPlayable ? badge : 'Soon';
---

<article
        class:list={[
            "bg-gray-800 rounded-xl overflow-hidden shadow-lg transition-all duration-300 flex flex-col border border-gray-700 group",
            isPlayable ? "hover:shadow-blue-500/20 hover:border-blue-500" : "opacity-80"
        ]}
>

    <div class="h-48 bg-gray-700 flex items-center justify-center relative overflow-hidden">

        {coverUrl ? (
                <img
                        src={withBase(coverUrl)}
                        alt={`${title} cover`}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
        ) : (
                <span class="text-7xl text-gray-500 select-none" aria-hidden="true">{icon ?? title.charAt(0)}</span>
        )}

        {shownBadge && (
                <span
                        class:list={[
                            "absolute top-4 right-4 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-md",
                            isPlayable ? "bg-blue-600 text-white" : "bg-gray-900/80 text-gray-300 border border-gray-600"
                        ]}
                >
                {shownBadge}
            </span>
        )}
    </div>

    <div class="p-6 flex flex-col flex-grow">
        <h3 class="text-2xl font-bold text-white mb-2">{title}</h3>
        <p class="text-gray-400 mb-6 flex-grow">{description}</p>
        {isPlayable ? (
                <a href={withBase(gameUrl)} class="block w-full text-center bg-blue-600 hover:bg-blue-500 text-white font-semibold py-3 px-4 rounded-lg transition-colors">
                    Play Now
                </a>
        ) : (
                <span class="block w-full text-center bg-gray-700 text-gray-400 font-semibold py-3 px-4 rounded-lg cursor-not-allowed" aria-disabled="true">
                    Coming soon
                </span>
        )}
    </div>
</article>
