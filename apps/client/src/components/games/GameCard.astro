---
// Define the shape of the component properties using TypeScript
interface Props {
    title: string;
    description: string;
    badge?: string;
    gameUrl: string;
    coverUrl?: string;
}

// Destructure the properties from Astro.props
const { title, description, badge, gameUrl, coverUrl } = Astro.props;

// Helper to safely handle slashes for GitHub Pages
const withBase = (path: string) => {
    const cleanPath = path.startsWith('/') ? path.slice(1) : path;
    const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
    return `${base}${cleanPath}`;
};
---

<article class="bg-gray-800 rounded-xl overflow-hidden shadow-lg hover:shadow-blue-500/20 transition-all duration-300 flex flex-col border border-gray-700 hover:border-blue-500 group">

    <div class="h-48 bg-gray-700 flex items-center justify-center relative overflow-hidden">

        {coverUrl ? (
                <img
                        src={withBase(coverUrl)}
                        alt={`${title} cover`}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
        ) : (
                <span class="text-gray-500 font-medium">Image Placeholder</span>
        )}

        {badge && (
                <span class="absolute top-4 right-4 bg-blue-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-md">
                {badge}
            </span>
        )}
    </div>

    <div class="p-6 flex flex-col flex-grow">
        <h3 class="text-2xl font-bold text-white mb-2">{title}</h3>
        <p class="text-gray-400 mb-6 flex-grow">{description}</p>
        <a href={withBase(gameUrl)} class="block w-full text-center bg-blue-600 hover:bg-blue-500 text-white font-semibold py-3 px-4 rounded-lg transition-colors">
            Play Now
        </a>
    </div>
</article>