---
// Footer component for global site bottom
// Компонент Footer для глобального подвала сайта
import { withBase } from '@utils/withBase';
---

<!-- Semantic footer wrapper with Tailwind styling -->
<!-- Семантическая обертка подвала со стилями Tailwind -->
<footer class="bg-gray-800 text-gray-400 py-6 mt-auto shadow-inner">

    <!-- Container to align content centrally -->
    <!-- Контейнер для выравнивания контента по центру -->
    <div class="container mx-auto px-6 text-center">

        <!-- Copyright information -->
        <!-- Информация об авторских правах -->
        <p class="text-sm">
            &copy; 2026 Cosmo Game Hub. All rights reserved. ·
            <a href="https://github.com/DubnovAlexey/cosmo-game-hub" class="underline hover:text-white" target="_blank" rel="noopener noreferrer">Source code on GitHub</a>
        </p>

        <!-- [EN] The bundled chess engine is GPL-3.0: every page links to its license and source -->
        <!-- [RU] Встроенный шахматный движок под GPL-3.0: с каждой страницы есть ссылка на лицензию и исходники -->
        <p class="text-xs mt-2">
            Chess engine: Stockfish (GPL-3.0) ·
            <a href={withBase('/engines/chess/COPYING.txt')} class="underline hover:text-white">License</a> ·
            <a href="https://github.com/lichess-org/stockfish.js/tree/e105072e84cf8ee5dd5219e2c5be29c3b8bf8a5a" class="underline hover:text-white" target="_blank" rel="noopener noreferrer">Source code</a>
        </p>

    </div>
</footer>