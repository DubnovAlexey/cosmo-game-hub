---
// Header component for global site navigation
// Компонент Header для глобальной навигации по сайту

// Get the current URL path to determine active links
// Получаем текущий путь URL для определения активных ссылок
const currentPath = Astro.url.pathname;

// [EN] NEW: base-aware path helper. Required once `base: '/cosmo-game-hub'` is set in
// astro.config.mjs for GitHub Pages — hardcoded hrefs like href="/games" would otherwise point at
// the domain root and 404 once deployed under a repo-name subpath.
// [RU] НОВОЕ: хелпер для путей с учётом base. Нужен, как только в astro.config.mjs выставлен
// `base: '/cosmo-game-hub'` для GitHub Pages — иначе жёстко прописанные href вида href="/games"
// будут вести в корень домена и дадут 404 после деплоя под подпутём с именем репозитория.
const withBase = (path: string) => `${import.meta.env.BASE_URL}${path}`;
---

<!-- Semantic header wrapper -->
<!-- Семантическая обертка шапки -->
<header class="bg-gray-800 text-white shadow-md">

    <!-- Responsive flex container -->
    <!-- Адаптивный flex-контейнер -->
    <div class="container mx-auto px-6 py-4 flex flex-col md:flex-row justify-between items-center gap-4">

        <!-- Site Logo -->
        <!-- Логотип сайта -->
        <a href={withBase('/')} class="text-2xl font-bold text-blue-400 hover:text-blue-300 transition-colors text-center">
            Cosmo Game Hub
        </a>

        <!-- Main Navigation Menu -->
        <!-- Главное навигационное меню -->
        <nav class="w-full md:w-auto">
            <ul class="flex flex-wrap justify-center space-x-4 md:space-x-8 text-lg font-medium">

                <li>
                    <!-- Use class:list for conditional active styling -->
                    <!-- Используем class:list для условной активной стилизации -->
                    <!-- [EN] NEW: compare against withBase(...) too, not just the raw path — otherwise -->
                    <!-- active-link highlighting silently breaks once the site is served under /cosmo-game-hub/ -->
                    <!-- [RU] НОВОЕ: сравниваем тоже с withBase(...), а не с сырым путём — иначе -->
                    <!-- подсветка активной ссылки тихо ломается, как только сайт отдаётся из-под /cosmo-game-hub/ -->
                    <a
                            href={withBase('/games')}
                            class:list={[
                                "transition-all duration-300",
                                currentPath.startsWith(withBase('/games')) ? "text-blue-400 font-bold border-b-2 border-blue-400 pb-1" : "text-gray-300 hover:text-white"
                            ]}
                    >
                        Games
                    </a>
                </li>

                <li>
                    <a
                            href={withBase('/leaderboard')}
                            class:list={[
                                "transition-all duration-300",
                                currentPath === withBase('/leaderboard') ? "text-blue-400 font-bold border-b-2 border-blue-400 pb-1" : "text-gray-300 hover:text-white"
                            ]}
                    >
                        Leaderboard
                    </a>
                </li>

                <li>
                    <a
                            href={withBase('/about')}
                            class:list={[
                                "transition-all duration-300",
                                currentPath === withBase('/about') ? "text-blue-400 font-bold border-b-2 border-blue-400 pb-1" : "text-gray-300 hover:text-white"
                            ]}
                    >
                        About
                    </a>
                </li>

            </ul>
        </nav>

        <!-- User Authentication Actions -->
        <!-- Действия аутентификации пользователя -->
        <div class="w-full md:w-auto flex justify-center">
            <button class="bg-blue-600 hover:bg-blue-700 px-8 py-2 rounded-lg font-semibold transition-colors w-full md:w-auto shadow-lg hover:shadow-blue-500/20">
                Login
            </button>
        </div>

    </div>
</header>