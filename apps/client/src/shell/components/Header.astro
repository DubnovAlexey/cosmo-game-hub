---
// Header component for global site navigation
// Компонент Header для глобальной навигации по сайту

// Get the current URL path to determine active links
// Получаем текущий путь URL для определения активных ссылок
const currentPath = Astro.url.pathname;

// [EN] Base-aware path helper, shared with the pages (src/utils/withBase.ts). Required once
// `base: '/cosmo-game-hub'` is set in astro.config.mjs for GitHub Pages — hardcoded hrefs like
// href="/games" would otherwise point at the domain root and 404 under a repo-name subpath.
// [RU] Хелпер для путей с учётом base, общий со страницами (src/utils/withBase.ts). Нужен, как
// только в astro.config.mjs выставлен `base: '/cosmo-game-hub'` для GitHub Pages — иначе жёстко
// прописанные href вида href="/games" будут вести в корень домена и дадут 404.
import { withBase, isNavigationPathActive } from '../utils/withBase';
import { LANGUAGES } from '@shared/i18n/languages';

// Один pathname-контракт для подсветки и aria-current, включая production URL со слешем.
const gamesActive = isNavigationPathActive(currentPath, withBase('/games'), true);
const leaderboardActive = isNavigationPathActive(currentPath, withBase('/leaderboard'));
const aboutActive = isNavigationPathActive(currentPath, withBase('/about'));
---

<!-- Semantic header wrapper -->
<!-- Семантическая обертка шапки -->
<header class="bg-gray-800 text-white shadow-md">

    <!-- Responsive flex container -->
    <!-- Адаптивный flex-контейнер -->
    <div class="container mx-auto px-6 py-4 flex flex-col md:flex-row justify-between items-center gap-4">

        <!-- Site Logo -->
        <!-- Логотип сайта -->
        <a href={withBase('/')} class="text-2xl font-bold text-blue-400 hover:text-blue-300 transition-colors text-center">
            Cosmo Game Hub
        </a>

        <!-- Main Navigation Menu -->
        <!-- Главное навигационное меню -->
        <nav class="w-full md:w-auto">
            <ul class="flex flex-wrap justify-center space-x-4 md:space-x-8 text-lg font-medium">

                <li>
                    <!-- Use class:list for conditional active styling -->
                    <!-- Используем class:list для условной активной стилизации -->
                    <!-- [EN] NEW: compare against withBase(...) too, not just the raw path — otherwise -->
                    <!-- active-link highlighting silently breaks once the site is served under /cosmo-game-hub/ -->
                    <!-- [RU] НОВОЕ: сравниваем тоже с withBase(...), а не с сырым путём — иначе -->
                    <!-- подсветка активной ссылки тихо ломается, как только сайт отдаётся из-под /cosmo-game-hub/ -->
                    <a
                            href={withBase('/games')}
                            aria-current={gamesActive ? 'page' : undefined}
                            class:list={[
                                "transition-all duration-300",
                                gamesActive ? "text-blue-400 font-bold border-b-2 border-blue-400 pb-1" : "text-gray-300 hover:text-white"
                            ]}
                    >
                        <span data-i18n="nav.games">Games</span>
                    </a>
                </li>

                <li>
                    <a
                            href={withBase('/leaderboard')}
                            aria-current={leaderboardActive ? 'page' : undefined}
                            class:list={[
                                "transition-all duration-300",
                                leaderboardActive ? "text-blue-400 font-bold border-b-2 border-blue-400 pb-1" : "text-gray-300 hover:text-white"
                            ]}
                    >
                        <span data-i18n="nav.leaderboard">Leaderboard</span>
                    </a>
                </li>

                <li>
                    <a
                            href={withBase('/about')}
                            aria-current={aboutActive ? 'page' : undefined}
                            class:list={[
                                "transition-all duration-300",
                                aboutActive ? "text-blue-400 font-bold border-b-2 border-blue-400 pb-1" : "text-gray-300 hover:text-white"
                            ]}
                    >
                        <span data-i18n="nav.about">About</span>
                    </a>
                </li>

            </ul>
        </nav>

        <!-- User Authentication Actions -->
        <!-- Действия аутентификации пользователя -->
        <!-- [EN] Player accounts are not built yet: the button is honestly disabled instead of doing nothing on click -->
        <!-- [RU] Аккаунтов игроков пока нет: кнопка честно выключена, а не молчит при нажатии -->
        <div class="w-full md:w-auto flex flex-wrap justify-center items-center gap-3">
            <!-- [EN] The site language: the same choice as inside the games (five languages, Hebrew right to left).
                 [RU] Язык сайта: тот же выбор, что внутри игр (пять языков, иврит справа налево). -->
            <label class="flex items-center gap-2 text-gray-300">
                <span aria-hidden="true">🌐</span>
                <span class="sr-only" data-i18n="nav.language">Language</span>
                <select data-language-switch class="bg-gray-700 text-white border border-gray-600 rounded-lg px-3 min-h-[44px] cursor-pointer">
                    {LANGUAGES.map(language => <option value={language.code} lang={language.code} dir={language.dir}>{language.name}</option>)}
                </select>
            </label>
            <button
                    type="button"
                    disabled
                    title="Player accounts are coming soon"
                    data-i18n-title="nav.loginTitle"
                    class="bg-gray-700 text-gray-400 px-8 rounded-lg font-semibold min-h-[44px] cursor-not-allowed"
            >
                <span data-i18n="nav.login">Login · soon</span>
            </button>
        </div>

    </div>
</header>