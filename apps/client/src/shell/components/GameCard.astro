---
import { withBase } from '../utils/withBase';

// Define the shape of the component properties using TypeScript
interface Props {
    title: string;
    description: string;
    badge?: string;
    gameUrl: string;
    coverUrl?: string;
    status: 'playable' | 'soon';
    icon?: string;
}

// Destructure the properties from Astro.props
const { title, description, badge, gameUrl, coverUrl, status, icon } = Astro.props;

// [EN] The texts are keyed by the last part of the game's address («/games/preferans» → game.preferans.*), so the
//      card follows the site language (shell/i18n/shellTexts.ts). [RU] Тексты — по последней части адреса игры
//      («/games/preferans» → game.preferans.*), поэтому карточка следует языку сайта (shell/i18n/shellTexts.ts).
const slug = gameUrl.split('/').filter(Boolean).pop() ?? '';
// [EN] A game without its own page gets a "Coming soon" card: no link, no misleading badge.
// [RU] Игра без своей страницы получает карточку «Скоро»: без ссылки и без вводящего в заблуждение значка.
const isPlayable = status === 'playable';
const shownBadge = isPlayable ? badge : 'Soon';
---

<!-- [EN] Under the mouse the whole card comes forward and grows one and a half times (Alexey, 10.11.2026: «the windows
          themselves must grow, not the pictures inside them»): `game-card` in shell/styles/global.css. The cover of a
          playable game is a link too, so a click on the picture opens the game like the button does; the keyboard
          keeps one stop — the button.
     [RU] Под мышью вся карточка выходит вперёд и вырастает в полтора раза (Алексей, 10.11.2026: «сами окошки должны
          увеличиваться, а не картинки в них»): `game-card` в shell/styles/global.css. Обложка играбельной игры —
          тоже ссылка, поэтому щелчок по картинке открывает игру так же, как кнопка; у клавиатуры остаётся одна
          остановка — кнопка. -->
<article
        class:list={[
            "game-card bg-gray-800 rounded-xl overflow-hidden shadow-lg flex flex-col border border-gray-700 group",
            isPlayable ? "hover:shadow-blue-500/20 hover:border-blue-500" : "opacity-80"
        ]}
>

    {isPlayable ? (
            <a href={withBase(gameUrl)} tabindex="-1" aria-hidden="true" class="h-48 bg-gray-700 flex items-center justify-center relative overflow-hidden">
            {coverUrl ? (
                    <img
                            src={withBase(coverUrl)}
                            alt={`${title} cover`}
                            class="w-full h-full object-cover"
                    />
            ) : (
                    <span class="text-7xl text-gray-500 select-none" aria-hidden="true">{icon ?? title.charAt(0)}</span>
            )}
            {shownBadge && (
                    <span
                            class:list={[
                                "absolute top-4 right-4 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-md",
                                isPlayable ? "bg-blue-600 text-white" : "bg-gray-900/80 text-gray-300 border border-gray-600"
                            ]}
                    >
                    <span data-i18n={`badge.${shownBadge}`}>{shownBadge}</span>
                </span>
            )}
            </a>
    ) : (
            <div class="h-48 bg-gray-700 flex items-center justify-center relative overflow-hidden">
            {coverUrl ? (
                    <img
                            src={withBase(coverUrl)}
                            alt={`${title} cover`}
                            class="w-full h-full object-cover"
                    />
            ) : (
                    <span class="text-7xl text-gray-500 select-none" aria-hidden="true">{icon ?? title.charAt(0)}</span>
            )}
            {shownBadge && (
                    <span
                            class:list={[
                                "absolute top-4 right-4 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-md",
                                isPlayable ? "bg-blue-600 text-white" : "bg-gray-900/80 text-gray-300 border border-gray-600"
                            ]}
                    >
                    <span data-i18n={`badge.${shownBadge}`}>{shownBadge}</span>
                </span>
            )}
            </div>
    )}

    <div class="p-6 flex flex-col flex-grow">
        <h3 class="text-2xl font-bold text-white mb-2" data-i18n={`game.${slug}.title`}>{title}</h3>
        <p class="text-gray-400 mb-6 flex-grow" data-i18n={`game.${slug}.description`}>{description}</p>
        {isPlayable ? (
                <a href={withBase(gameUrl)} class="block w-full text-center bg-blue-600 hover:bg-blue-500 text-white font-semibold py-3 px-4 rounded-lg transition-colors">
                    <span data-i18n="card.play">Play now</span>
                </a>
        ) : (
                <span class="block w-full text-center bg-gray-700 text-gray-400 font-semibold py-3 px-4 rounded-lg cursor-not-allowed" aria-disabled="true">
                    <span data-i18n="card.soon">Coming soon</span>
                </span>
        )}
    </div>
</article>
