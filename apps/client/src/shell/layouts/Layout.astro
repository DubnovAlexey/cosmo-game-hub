---
// [EN] Import floating button component
// [RU] Импортируем компонент плавающей кнопки
import ScrollToTop from '../components/ScrollToTop.astro';

// [EN] Import global styles for Tailwind CSS
// [RU] Импортируем глобальные стили для Tailwind CSS
import '../styles/global.css';

// [EN] Import UI components using Path Aliases
// [RU] Импортируем UI-компоненты, используя псевдонимы путей
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/withBase';

// [EN] Define the shape of our Props using a TypeScript interface
// [RU] Определяем структуру наших Props с помощью интерфейса TypeScript
interface Props {
    title: string;
    /**
     * [EN] Key of the page name in shell/i18n/shellTexts.ts: the tab title follows the chosen language.
     * [RU] Ключ названия страницы в shell/i18n/shellTexts.ts: заголовок вкладки следует выбранному языку.
     */
    titleKey?: string;
    /**
     * [EN] The floating «to top» button; game pages switch it off, so it never covers the game's controls on a phone.
     * [RU] Плавающая кнопка «наверх»; страницы игр её выключают, чтобы на телефоне она не закрывала кнопки игры.
     */
    scrollToTop?: boolean;
    /**
     * [EN] A game's own favicon: the path without the extension, next to which favicon.webp (192 px) and favicon.png
     *      (64 px) lie, e.g. '/games/checkers/favicon'. Without it the page shows the hub's crystal.
     * [RU] Собственный фавикон игры: путь без расширения, рядом с которым лежат favicon.webp (192 px) и favicon.png
     *      (64 px), например '/games/checkers/favicon'. Без него страница показывает кристалл хаба.
     */
    favicon?: string;
}

// [EN] Destructure the title from Astro.props
// [RU] Деструктуризируем title из Astro.props
const {title, titleKey, scrollToTop = true, favicon = '/favicon'} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-title-key={titleKey}>
<head>
    <meta charset="UTF-8">
    <!-- [EN] Before anything is drawn: the saved language and its direction (Hebrew right to left), so the page does not
         jump. The texts follow a moment later (shell/i18n/applyLanguage.ts).
         [RU] До первой отрисовки: сохранённый язык и его направление (иврит справа налево), чтобы страница не прыгала.
         Тексты подтягиваются мгновением позже (shell/i18n/applyLanguage.ts). -->
    <script is:inline>
        try {
            var saved = localStorage.getItem('cosmo-game-hub:language');
            if (saved && /^(ru|en|he|es|fr)$/.test(saved)) {
                document.documentElement.lang = saved;
                document.documentElement.dir = saved === 'he' ? 'rtl' : 'ltr';
            }
        } catch (error) { /* private mode: English until the script below runs */ }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Cosmo Game Hub - Play and Learn">

    <!-- [EN] The favicon: a red octahedron crystal, shaped like an eight-sided die. WebP 192 px for sharp screens and the
         UNIVERSE planet, PNG 64 px for the tab. withBase keeps the path inside /cosmo-game-hub/ on GitHub Pages (no 404). -->
    <!-- [RU] Фавикон: красный кристалл-октаэдр, похожий на восьмигранный игральный кубик. WebP 192 px для чётких экранов и
         планеты в UNIVERSE, PNG 64 px для вкладки. withBase держит путь внутри /cosmo-game-hub/ на GitHub Pages (без 404). -->
    <link rel="icon" type="image/webp" sizes="192x192" href={withBase(`${favicon}.webp`)} />
    <link rel="icon" type="image/png" sizes="64x64" href={withBase(`${favicon}.png`)} />

    <!-- [EN] Dynamic title injection -->
    <!-- [RU] Динамическая вставка заголовка -->
    <title>{title}</title>
</head>

<!-- [EN] Body acts as a flex container to push footer to the bottom -->
<!-- [RU] Body выступает в роли flex-контейнера, чтобы прижать подвал к низу -->
<body class="bg-gray-900 text-white min-h-screen flex flex-col">

<!-- [EN] Global Header Component -->
<!-- [RU] Глобальный компонент Header -->
<Header/>

<!-- [EN] Main content wrapper that grows to fill available space -->
<!-- [RU] Обертка основного контента, которая растягивается на доступное пространство -->
<main class="flex-grow">

    <!-- [EN] The page content will be injected into this slot -->
    <!-- [RU] Контент страницы будет вставлен в этот слот -->
    <slot/>

</main>

<!-- [EN] Global Footer Component -->
<!-- [RU] Глобальный компонент Footer -->
<Footer/>

<!-- [EN] Floating scroll-to-top button -->
<!-- [RU] Плавающая кнопка прокрутки наверх -->
{scrollToTop && <ScrollToTop/>}

<!-- [EN] The hub's texts in the chosen language, following the switch in the header and the ones inside the games. -->
<!-- [RU] Тексты хаба на выбранном языке; следуют переключателю в шапке и переключателям внутри игр. -->
<script>
    import { startShellLanguage } from '../i18n/applyLanguage';
    import { startSurprisesToggle } from '../utils/surprisesToggle';
    startShellLanguage();
    startSurprisesToggle();
</script>
</body>
</html>