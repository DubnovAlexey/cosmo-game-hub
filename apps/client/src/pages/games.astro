---
// [EN] Define the properties this component expects to receive
// [RU] Определяем свойства, которые ожидает получить этот компонент
interface Props {
    title: string;
    description: string;
    badge?: string;
    gameUrl: string;
    coverUrl?: string; // [EN] NEW: Optional cover image [RU] НОВОЕ: Необязательная картинка-обложка
}

// [EN] Destructure props
// [RU] Деструктуризируем пропсы
const { title, description, badge, gameUrl, coverUrl } = Astro.props;

// [EN] Helper function to safely prepend BASE_URL for GitHub Pages
// [RU] Вспомогательная функция для безопасного добавления BASE_URL для GitHub Pages
const getAssetUrl = (path: string) => {
    const cleanPath = path.startsWith('/') ? path.slice(1) : path;
    const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
    return `${base}${cleanPath}`;
};
---

<!-- [EN] Card acts as a clickable link entirely -->
<!-- [RU] Вся карточка работает как кликабельная ссылка -->
<a href={getAssetUrl(gameUrl)} class="block bg-gray-800 rounded-xl shadow-lg border border-gray-700 hover:border-blue-500 transition-colors overflow-hidden group">

    <!-- [EN] Image / Placeholder container -->
    <!-- [RU] Контейнер для картинки / заглушки -->
    <div class="h-48 bg-gray-700 relative overflow-hidden flex items-center justify-center">

        {coverUrl ? (
            <!-- [EN] Render the image if coverUrl is provided -->
            <!-- [RU] Рендерим картинку, если передан coverUrl -->
                <img
                        src={getAssetUrl(coverUrl)}
                        alt={`${title} cover`}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
        ) : (
            <!-- [EN] Fallback placeholder if no image is provided -->
            <!-- [RU] Резервная заглушка, если картинка не передана -->
                <span class="text-gray-500 font-medium">Image Placeholder</span>
        )}

        <!-- [EN] Optional Badge (e.g., "HOT", "PRO") -->
        <!-- [RU] Необязательный бейдж (например, "HOT", "PRO") -->
        {badge && (
                <span class="absolute top-3 right-3 bg-blue-600 text-white text-xs font-bold px-2 py-1 rounded uppercase tracking-wide shadow-md">
                {badge}
            </span>
        )}
    </div>

    <!-- [EN] Text Content -->
    <!-- [RU] Текстовый контент -->
    <div class="p-6">
        <h3 class="text-2xl font-bold text-white mb-2">{title}</h3>
        <p class="text-gray-400 mb-6 h-12 overflow-hidden text-sm leading-relaxed">{description}</p>

        <div class="w-full bg-blue-600 group-hover:bg-blue-500 text-white text-center font-semibold py-2 rounded transition-colors">
            Play Now
        </div>
    </div>
</a>