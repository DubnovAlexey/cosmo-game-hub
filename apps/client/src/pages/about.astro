---
// Import the global Layout component using Path Alias
// Импортируем глобальный компонент Layout, используя псевдоним пути
import Layout from '@shell/layouts/Layout.astro';

// [EN] FIX: links go through withBase — a raw href="/games" led to the domain root (404 on Pages)
// [RU] ИСПРАВЛЕНИЕ: ссылки идут через withBase — «сырой» href="/games" вёл в корень домена (404 на Pages)
import { withBase } from '@shell/utils/withBase';
---

<!-- Wrap the page content in the Layout -->
<!-- Оборачиваем контент страницы в Layout -->
<Layout title="About | Cosmo Game Hub" titleKey="title.about">

    <!-- Main container with vertical padding and centered content -->
    <!-- Главный контейнер с вертикальными отступами и отцентрированным контентом -->
    <div class="container mx-auto px-6 py-12 max-w-4xl">

        <!-- Page Title -->
        <!-- Заголовок страницы -->
        <h1 class="text-4xl font-bold text-blue-400 mb-8 text-center" data-i18n="about.title">
            About Cosmo Game Hub
        </h1>

        <!-- Content Wrapper with card styling -->
        <!-- Обертка контента со стилизацией карточки -->
        <div class="bg-gray-800 rounded-xl shadow-lg border border-gray-700 p-8 md:p-12">

            <!-- Section Title -->
            <!-- Заголовок секции -->
            <h2 class="text-2xl font-semibold text-white mb-4" data-i18n="about.mission">Our mission</h2>

            <!-- Text Paragraph -->
            <!-- Текстовый абзац -->
            <p class="text-gray-300 leading-relaxed mb-8" data-i18n="about.missionText">
                A modern, fast home for classic logic games — chess, preferans and more to come — that plays as well with a finger on a phone or tablet as with a mouse on a computer. Beginner or grandmaster, you will find your challenge here.
            </p>

            <!-- Section Title -->
            <!-- Заголовок секции -->
            <h2 class="text-2xl font-semibold text-white mb-4" data-i18n="about.stack">Technology</h2>

            <!-- Unordered List -->
            <!-- Маркированный список -->
            <ul class="list-disc list-inside text-gray-300 space-y-3 mb-10">
                <li data-i18n="about.stack1">Built with Astro for speed and search engines.</li>
                <li data-i18n="about.stack2">Styled with Tailwind CSS and CSS Modules for a responsive look on every screen.</li>
                <li data-i18n="about.stack3">Interactive islands in React run the game logic.</li>
                <li data-i18n="about.stack4">Computer players think in Web Workers, so the page stays responsive while they do.</li>
            </ul>

            <!-- [EN] Third-party engine notice required by its GPL-3.0 license -->
            <!-- [RU] Сведения о стороннем движке, которых требует его лицензия GPL-3.0 -->
            <h2 class="text-2xl font-semibold text-white mb-4" data-i18n="about.open">Open source</h2>
            <p class="text-gray-300 leading-relaxed">
                <span data-i18n="about.open1">The chess engine is</span> <a href="https://stockfishchess.org/" class="text-blue-400 hover:text-blue-300 underline" target="_blank" rel="noopener noreferrer">Stockfish</a><span data-i18n="about.open2">, compiled to JavaScript by the stockfish.js project (version 10.0.2) and distributed under the</span>
                <a href={withBase('/games/chess/COPYING.txt')} class="text-blue-400 hover:text-blue-300 underline" data-i18n="about.gpl">GNU General Public License v3</a><span data-i18n="about.open3">. Its complete source code is available at</span>
                <a href="https://github.com/lichess-org/stockfish.js/tree/e105072e84cf8ee5dd5219e2c5be29c3b8bf8a5a" class="text-blue-400 hover:text-blue-300 underline" target="_blank" rel="noopener noreferrer">lichess-org/stockfish.js</a>.
            </p>

            <!-- Call to Action Button Container -->
            <!-- Контейнер кнопки призыва к действию -->
            <div class="text-center mt-8 pt-8 border-t border-gray-700">
                <a href={withBase('/games')} class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-8 rounded-lg transition-colors shadow-lg hover:shadow-blue-500/20">
                    <span data-i18n="about.cta">Start playing now</span>
                </a>
            </div>

        </div>

    </div>

</Layout>