// [RU] Маршрут /games/poker. Страница только ставит игру на место: всё остальное — в src/games/poker.
import Layout from '@shell/layouts/Layout.astro';
import { PokerGame } from '@games/poker';
---

<Layout title="Poker | Cosmo Game Hub" titleKey="title.poker" scrollToTop={false}>
