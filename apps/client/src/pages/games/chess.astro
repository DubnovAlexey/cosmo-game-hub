---
// [EN] Import the main Layout component using configured path alias
// [RU] Импортируем главный компонент макета, используя настроенный алиас пути
import Layout from '@layouts/Layout.astro';

// [EN] Import the React ChessGame component using configured path alias
// [RU] Импортируем React-компонент шахматной игры, используя настроенный алиас пути
import ChessGame from '@components/games/chess/ChessGame';
---

<!-- [EN] Use the Layout component to wrap our page and set metadata -->
<!-- [RU] Используем компонент Layout для обертки нашей страницы и установки метаданных -->
<Layout title="Chess | Cosmo Game Hub">

    <!-- [EN] CRITICAL: Render ChessGame strictly on the client side -->
    <!-- [EN] This prevents Node.js from crashing when trying to execute stockfish.js during SSR -->
    <!-- [RU] КРИТИЧНО: Рендерим ChessGame строго на стороне клиента -->
    <!-- [RU] Это предотвращает падение Node.js при попытке выполнить stockfish.js во время SSR -->
    <ChessGame client:only="react" />

</Layout>